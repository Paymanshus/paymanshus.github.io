# LiveKit Cloud (from https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://project-url.livekit.cloud
LIVEKIT_API_KEY=livekit_api_key
LIVEKIT_API_SECRET=livekit_api_secret

# Google AI / Gemini (from https://aistudio.google.com → Get API key)
GOOGLE_API_KEY=gemini_api_key # PortfolioVoice key

# Deepgram (from https://console.deepgram.com → API Keys)
DEEPGRAM_API_KEY=deepgram_api_key

# Cartesia TTS (from https://play.cartesia.ai → API Keys)
CARTESIA_API_KEY=cartesia_api_key

# Cartesia Voice ID (browse voices at play.cartesia.ai)
# Default: a warm male professional voice. Override to change.
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22 

# Cartesia TTS model. Bare "sonic" was sunsetted (returns 400).
# Verified working: sonic-2, sonic-3, sonic-turbo (see tests/probe_cartesia.sh)
CARTESIA_MODEL=sonic-3

# Optional: set to "true" to use Google Chirp STT instead of Deepgram
USE_GOOGLE_STT=false

# Terminal chat endpoint (POST /api/chat) LLM. Falls back to
# gemini-flash-lite-latest then gemini-3.5-flash on capacity errors.
# NOTE: Google silently sunsets free-tier models (2.5-flash/-lite died
# mid-2026). Check availability with: python tests/probe_gemini.py
TERMINAL_LLM_MODEL=gemini-3.1-flash-lite

# Voice agent LLM fallback chain (comma-separated, tried in order via
# LiveKit FallbackAdapter)
VOICE_LLM_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-flash-lite-latest

# Hard cap on spoken-answer length (tokens). Keeps replies conversational
# and protects TTS credits.
VOICE_MAX_OUTPUT_TOKENS=140

# BM25 top-score below which the full resume is injected instead of
# retrieved sections (calibrated in tests/test_resume_context.py)
RESUME_SCORE_THRESHOLD=2.5

# Endpointing: how long the agent waits after you stop speaking before
# replying (seconds). Lower = snappier, higher = fewer interruptions.
MIN_ENDPOINTING_DELAY=0.4

# Port for the embedded token/chat HTTP server
TOKEN_SERVER_PORT=8080

# ─── Langfuse observability (optional; from https://cloud.langfuse.com →
# Project Settings → API Keys). Without keys everything is a no-op.
# Traces captured when set: voice sessions (LiveKit OTel spans — agent turns,
# LLM prompts/completions, TTS/STT, EOU) and terminal /api/chat (per-model
# Gemini generations with token usage, so Langfuse computes LLM costs).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Voice cost estimates (USD) for the per-session usage summary span.
# Defaults are mid-2026 list-price approximations; override to match plans.
# COST_LLM_INPUT_PER_1M=0.30
# COST_LLM_OUTPUT_PER_1M=2.50
# COST_STT_PER_MIN=0.0077
# COST_TTS_PER_1K_CHARS=0.03
