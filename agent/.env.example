# LiveKit Cloud (from https://cloud.livekit.io → Settings → Keys)
LIVEKIT_URL=wss://project-url.livekit.cloud
LIVEKIT_API_KEY=livekit_api_key
LIVEKIT_API_SECRET=livekit_api_secret

# Google AI / Gemini (from https://aistudio.google.com → Get API key)
GOOGLE_API_KEY=gemini_api_key # PortfolioVoice key

# Deepgram (from https://console.deepgram.com → API Keys)
DEEPGRAM_API_KEY=deepgram_api_key

# Cartesia TTS (from https://play.cartesia.ai → API Keys)
CARTESIA_API_KEY=cartesia_api_key

# Cartesia Voice ID (browse voices at play.cartesia.ai)
# Default: a warm male professional voice. Override to change.
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22 

# Cartesia TTS model. Bare "sonic" was sunsetted (returns 400).
# Verified working: sonic-2, sonic-3, sonic-turbo (see tests/probe_cartesia.sh)
CARTESIA_MODEL=sonic-3

# Optional: set to "true" to use Google Chirp STT instead of Deepgram
USE_GOOGLE_STT=false

# ─── OpenRouter (from https://openrouter.ai/settings/keys) ──────────
# Second provider in the LLM ladder; absorbs traffic spikes when Gemini's free
# RPM is saturated. Everything works without it — those rungs are skipped.
#
# SETUP: a one-off $10 lifetime deposit raises :free-model limits from 50 to
# 1,000 requests/day (20 RPM either way).
#
# This must be a RUNTIME key, not a provisioning key. A provisioning key only
# mints and manages runtime keys; it returns 401 "User not found" on
# /chat/completions, so pasting one here kills every OpenRouter rung. Mint a
# runtime key with limit + limit_reset=monthly (see agent/RUN.md) — that spend
# cap lives outside this process, so unlike the in-memory rate limits it
# survives a crash loop. Check which kind you have:
#   curl -sH "Authorization: Bearer $OPENROUTER_API_KEY" \
#     https://openrouter.ai/api/v1/key
# is_provisioning_key must be false; limit must be your ceiling, not null.
# is_free_tier:true in that response means the $10 deposit has NOT landed yet.
OPENROUTER_API_KEY=
# Set to false to disable the OpenRouter rungs without removing the key.
# OPENROUTER_ENABLED=true

# ─── LLM ladders ────────────────────────────────────────────────────
# Ordered "provider:model[|model2][@quota_group][~timeout_ms]" lists, tried top
# to bottom. Defaults and the reasoning behind the ordering live in
# agent/llm_models.py.
#   - provider is `gemini` or `openrouter`
#   - only the FIRST colon splits provider from model (OpenRouter slugs
#     contain ':free')
#   - |model2 becomes OpenRouter's models[] array: it falls through those
#     server-side on rate-limit errors, so free→paid costs one round trip
#   - @group makes entries share a breaker key, for providers whose models
#     share one quota pool
#   - ~ms overrides that rung's total request timeout
#
# MEASURED TTFT (2026-07-26, streaming, median of 3, thinking disabled):
#   gemini-3.1-flash-lite 607ms | gemini-flash-lite-latest 661ms
#   gemini-3.5-flash     6321ms | gemini-flash-latest  83787ms (unusable)
# Terminal leads with 3.5-flash for answer quality; voice leads with flash-lite
# because 6s of dead air mid-call is not survivable. Re-check any time with:
#   python tests/probe_llm.py
# LLM_LADDER=gemini:gemini-3.5-flash~15000,openrouter:nvidia/nemotron-3-super-120b-a12b:free|deepseek/deepseek-v4-flash,gemini:gemini-3.1-flash-lite,gemini:gemini-flash-lite-latest
# VOICE_LADDER=gemini:gemini-3.1-flash-lite,openrouter:nvidia/nemotron-3-nano-30b-a3b:free|deepseek/deepseek-v4-flash,gemini:gemini-flash-lite-latest
# SYNC_LADDER is free-only on purpose — scripts/sync_resume.py must not be able
# to spend money. It exits 1 rather than escalating.
# SYNC_LADDER=openrouter:nvidia/nemotron-3-super-120b-a12b:free,gemini:gemini-3.5-flash,gemini:gemini-flash-lite-latest

# Gemini thinking budget. MUST stay 0 unless you also raise the output caps:
# thinking tokens are charged against max_output_tokens, so with thinking on and
# a 200-token cap, 190 tokens went to reasoning and replies came back truncated
# mid-sentence ("At Maersk, I"). See agent/llm_models.py.
# GEMINI_THINKING_BUDGET=0

# Prompt layout, which decides whether the prompt prefix can be cached at all.
#   full_hint (default) persona + FULL resume in system; BM25 hint in user turn
#   full_only           persona + FULL resume in system; bare question
#   persona_bm25_user   persona only in system; BM25 + question in user turn
#   bm25_system         persona + BM25 in system — the original layout; the
#                       prefix changes per question so it can never cache
# Compare them with: python tests/eval_context_modes.py
# LLM_CONTEXT_MODE=full_hint

# Per-request timeouts (ms). Nothing had a timeout before, so a hung upstream
# call stalled a voice turn indefinitely.
#
# THESE ARE TOTAL REQUEST TIMEOUTS, NOT TTFT — easy to get wrong and silent when
# you do. Budget TTFT + (max_tokens / throughput): ~200 tokens at ~50 tok/s is
# ~4s of generation ON TOP of first-token latency. Set from TTFT alone and every
# rung times out before answering, including the fast ones.
# Per-rung overrides use the `~ms` suffix in the ladder specs above.
# LLM_TIMEOUT_MS_TERMINAL=8000
# LLM_TIMEOUT_MS_VOICE=6000
# LLM_TIMEOUT_MS_SYNC=60000

# Where per-day quota lockouts are persisted. The deployment runs
# Restart=always, so an in-memory-only daily lock would evaporate on every crash
# and send us straight back at an exhausted quota.
# LLM_BREAKER_STATE_PATH=./.llm_breaker.json
# LLM_TRANSIENT_COOLDOWN_S=20

# Hard cap on spoken-answer length (tokens). Keeps replies conversational
# and protects TTS credits.
VOICE_MAX_OUTPUT_TOKENS=140

# BM25 top-score below which the full resume is injected instead of
# retrieved sections (calibrated in tests/test_resume_context.py)
RESUME_SCORE_THRESHOLD=2.5

# Endpointing: how long the agent waits after you stop speaking before
# replying (seconds). Lower = snappier, higher = fewer interruptions.
MIN_ENDPOINTING_DELAY=0.4

# Port for the embedded token/chat HTTP server. Railway/Fly set PORT; that
# is used when TOKEN_SERVER_PORT is unset.
TOKEN_SERVER_PORT=8080

# LiveKit multilingual end-of-turn model (~500MB+ inference subprocess).
# true/false always wins. If unset, it is ON locally and OFF on Railway
# (RAILWAY_ENVIRONMENT), because Trial/Free RAM OOM-kills that child.
# VOICE_TURN_DETECTOR=true

# LiveKit start-mode default is 16 idle job processes. Leave unset (0) on
# small hosts. Set 1 on a box with ≥2 GB if you want a warm worker.
# AGENT_IDLE_PROCESSES=0

# ─── Langfuse observability (optional; from https://cloud.langfuse.com →
# Project Settings → API Keys). Without keys everything is a no-op.
# Traces captured when set: voice sessions (LiveKit OTel spans — agent turns,
# LLM prompts/completions, TTS/STT, EOU) and terminal /api/chat (one generation
# per ladder rung attempted, with token usage and cached-token counts, so a
# fallback walk is visible in a single trace). OpenRouter returns real per-request
# cost, which is recorded in preference to the estimates below.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Voice cost estimates (USD) for the per-session usage summary span.
# Defaults are mid-2026 list-price approximations; override to match plans.
# COST_LLM_INPUT_PER_1M=0.30
# COST_LLM_OUTPUT_PER_1M=2.50
# COST_STT_PER_MIN=0.0077
# COST_TTS_PER_1K_CHARS=0.03
