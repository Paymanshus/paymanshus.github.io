# Public site URL used for sitemap, canonical tags, and structured metadata.
# Set this to the final Pages domain in production.
NEXT_PUBLIC_SITE_URL="https://paymanshus.github.io"

# Voice/chat agent server (LiveKit token minting + terminal LLM).
#
# Leave EMPTY unless a real agent server is reachable from the public internet.
# `npm run dev` already falls back to http://localhost:8080 on its own, so this
# does not need setting for local work — see lib/agent.ts.
#
# An empty value means "no agent": the terminal answers from cached resume data
# and the voice tab shows its resting state, both without making a request.
# Never point this at localhost for a deployed build; that URL would resolve
# against each visitor's own machine and leak into their devtools.
NEXT_PUBLIC_AGENT_URL=""

# Google Analytics 4 measurement id (GA4 → Admin → Data streams → Web).
# Leave EMPTY in development: with no value, gtag.js is never loaded and every
# analytics call is a no-op. Set it in the Pages build to switch analytics on.
NEXT_PUBLIC_GA_ID=""

# Set to "true" to stamp debug_mode on every event so it shows up in the GA4
# DebugView in real time. Never enable in production.
NEXT_PUBLIC_GA_DEBUG=""

# Google Search Console HTML-tag verification. Paste ONLY the content value of
# the <meta name="google-site-verification" content="..."> tag GSC gives you.
# When empty, Next omits the tag entirely. See docs/SEO_SETUP.md.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
